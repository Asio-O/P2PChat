<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\P2PChat.Core\P2PChat.Core.csproj" />
		<ProjectReference Include="..\P2PChat.Networking\P2PChat.Networking.csproj" />
		<ProjectReference Include="..\P2PChat.Crypto\P2PChat.Crypto.csproj" />
		<ProjectReference Include="..\P2PChat.Chat\P2PChat.Chat.csproj" />
		<ProjectReference Include="..\P2PChat.FileTransfer\P2PChat.FileTransfer.csproj" />
		<ProjectReference Include="..\P2PChat.UI\P2PChat.UI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.File" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 默认发布方式: Native-AOT。直接 dotnet publish -c Release 即产出原生 exe -->
		<PublishAot>true</PublishAot>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<IsAotCompatible>true</IsAotCompatible>

		<!-- 全部 JSON 走源生成器 JsonContext，禁用反射回退以适配 AOT -->
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

		<!-- 应用清单声明 UTF-8，双击exe时 Windows 创建控制台即用 UTF-8 -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<!-- .NET 运行时层面启用 UTF-8 控制台 (双击exe时先于一切代码执行) -->
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Console.UseUtf8Encoding" Value="true" />
	</ItemGroup>

</Project>
